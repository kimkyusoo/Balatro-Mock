  - "\uD50C\uB808\uC774\uD55C \uD578\uB4DC\uC5D0 \uD3EC\uD568\uB41C \uB2E4\uC774\uC544\uBAAC\uB4DC
    \uCE74\uB4DC \uD55C \uC7A5\uB2F9 \uCE69 +50\uC744 \uC81C\uACF5\uD569\uB2C8\uB2E4."
  - "\uD50C\uB808\uC774\uD55C \uD578\uB4DC\uC5D0 \uD3EC\uD568\uB41C \uD558\uD2B8
    \uCE74\uB4DC \uD55C \uC7A5\uB2F9 \uCE69 +50\uC744 \uC81C\uACF5\uD569\uB2C8\uB2E4."
  - "\uD50C\uB808\uC774\uD55C \uD578\uB4DC\uC5D0 \uD3EC\uD568\uB41C \uD074\uB7FD
    \uCE74\uB4DC \uD55C \uC7A5\uB2F9 \uCE69 +50\uC744 \uC81C\uACF5\uD569\uB2C8\uB2E4."
